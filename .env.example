# Base URL of the customer's Jira Data Center, without trailing slash
JIRA_URL=https://jira.example.com
# Personal Access Token (Jira profile → Personal Access Tokens)
JIRA_PAT=
# Optional: override which issues are offered as "assigned to me"
# JIRA_ASSIGNED_JQL=assignee = currentUser() ORDER BY updated DESC
# Optional: time of day used as worklog start (Jira requires one), default 09:00
# WORKLOG_START=09:00
# Optional: port of the local UI, default 5199
# PORT=5199
